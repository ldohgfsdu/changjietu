#!/bin/sh
# arm64 hosts: run SDK aapt2 under qemu-x86_64.
# The android.aapt2FromMavenOverride property is host-local gradle config
# (e.g. ~/.gradle/gradle.properties) and must NOT be committed.
# SDK path is resolved from local.properties (sdk.dir); AAPT2_REAL overrides all.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SDK_DIR=""
if [ -f "$DIR/../local.properties" ]; then
  SDK_DIR=$(sed -n 's/^sdk\.dir=//p' "$DIR/../local.properties" | tail -n1)
fi
AAPT2_BIN="${AAPT2_REAL:-}"
if [ -z "$AAPT2_BIN" ]; then
  AAPT2_BIN="$SDK_DIR/build-tools/35.0.0/aapt2"
fi
if [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ]; then
  if command -v qemu-x86_64 >/dev/null 2>&1; then
    exec qemu-x86_64 "$AAPT2_BIN" "$@"
  fi
fi
exec "$AAPT2_BIN" "$@"